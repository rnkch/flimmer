#!/bin/bash
# Pre-commit: are the staged Go files formatted (golines, 100 columns)?
# It only checks. To fix:  cd go && golines -w --ignore-generated -m 100 $(git ls-files '*.go')
# Switch it on once per clone:  git config core.hooksPath .githooks
# Without golines installed it skips itself; CI runs the same check.
#   go install github.com/golangci/golines@v0.15.0
top=$(git rev-parse --show-toplevel)
# Staged Go files below go/, as paths relative to go/ (asked before the cd:
# git's path patterns are relative to the current directory).
files=$(git diff --cached --name-only --diff-filter=ACM -- "$top/go" | grep '\.go$' | sed 's|^go/||')
[ -z "$files" ] && exit 0
cd "$top/go" || exit 0

if ! command -v golines >/dev/null; then
    echo "pre-commit: golines isn't installed, formatting not checked (CI will)."
    echo "            go install github.com/golangci/golines@v0.15.0"
    exit 0
fi

# shellcheck disable=SC2086 # file names have no spaces
bad=$(golines -l --ignore-generated -m 100 $files)
if [ -n "$bad" ]; then
    echo "pre-commit: not formatted (golines, 100 columns):"
    echo "$bad" | sed 's/^/  /'
    echo "Fix:  cd go && golines -w --ignore-generated -m 100 \$(git ls-files '*.go')"
    exit 1
fi
