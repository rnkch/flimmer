# Installed by deploy.sh as /etc/systemd/system/flimmerkiste.service, with User=
# and /home/pi replaced by the deploying user and their home directory.
[Unit]
Description=Flimmerkiste looping display (mpv, web UI, Telegram bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/home/pi/.local/bin/flimmerkiste
Restart=always
RestartSec=3
# yt-dlp and deno (installed by setup.sh) live in ~/.local/bin.
Environment=PATH=/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=-5
# Output goes to the journal (journalctl -u flimmerkiste), which rotates it;
# journald-flimmerkiste.conf keeps it across reboots, capped at 50 MB.

[Install]
WantedBy=multi-user.target
