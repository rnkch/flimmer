package views

import (
	"github.com/rnkch/flimmerkiste/internal/kiosk"
	"github.com/rnkch/flimmerkiste/internal/store/db"
)

templ PlaylistPage(p Page, list []db.Media, currentID int64, activeJobs int) {
	@Layout(p) {
		@PageHead("Playlist") {
			<wa-spinner id="playlist-busy" class="htmx-indicator"></wa-spinner>
			@PlaylistSummary(list, activeJobs)
			<wa-button href="/add" { pageLink("/add")... } size="s" variant="brand">
				<wa-icon slot="start" name="plus"></wa-icon> { t(ctx, "Add") }
			</wa-button>
		}
		@PlayerPanel(p.Now)
		<wa-card class="panel" data-dropzone>
			<wa-progress-bar class="drop-progress" hidden></wa-progress-bar>
			@PlaylistList(list, currentID)
			<div class="drop-hint wa-caption-xs">{ t(ctx, "Drop files here to insert them at this spot") }</div>
		</wa-card>
		<div id="preview"></div>
	}
}

templ PlaylistSummary(list []db.Media, activeJobs int) {
	<span id="playlist-summary" class="wa-caption-s num">
		{ t(ctx, "%d entries", len(list)) }
		if n := disabledCount(list); n > 0 {
			({ t(ctx, "%d disabled", n) })
		}
		· { t(ctx, "Loop %s", Dur(loopSeconds(list))) }
		if activeJobs > 0 {
			· <wa-spinner></wa-spinner> { t(ctx, "%d processing", activeJobs) }
		}
	</span>
}

// PlaylistList is pushed over the live connection when the playlist or the playing entry
// changes anywhere (bot, other tab; handlers.go, events). Rows being edited carry
// hx-morph-skip, and the list is frozen the same way while a row is dragged.
templ PlaylistList(list []db.Media, currentID int64) {
	<ul id="playlist" class="rows playlist" data-sortable>
		if len(list) == 0 {
			<li class="empty-state">
				<wa-icon name="film" class="empty-icon"></wa-icon>
				<span class="wa-heading-s">{ t(ctx, "Nothing playing yet") }</span>
				<span class="wa-caption-s">{ t(ctx, "Drop images or videos here, or add a file or link.") }</span>
				<wa-button href="/add" { pageLink("/add")... } variant="brand" size="s"><wa-icon slot="start" name="plus"></wa-icon> { t(ctx, "Add something") }</wa-button>
			</li>
		}
		for _, m := range list {
			@MediaRow(m, m.ID == currentID, "")
		}
	</ul>
}

// MediaRow is one playlist entry on one line. edit is "", "title" or
// "duration": that value is shown as an inline form instead of text.
templ MediaRow(m db.Media, current bool, edit string) {
	<li id={ "media-" + id(m) } data-id={ id(m) } data-position={ itoa(m.Position) }
		class={ templ.KV("current", current), templ.KV("editing", edit != ""), templ.KV("off", !kiosk.Enabled(m)) }
		if edit == "" {
			draggable="true"
		} else {
			hx-morph-skip
		}>
		<span class="lead num">
			<wa-icon name="grip-vertical" class="grip" label={ t(ctx, "Drag to reorder") }></wa-icon>
			if current {
				<wa-icon name="play" class="now" label={ t(ctx, "Playing") }></wa-icon>
			} else {
				{ itoa(m.Position) }
			}
		</span>
		<a id={ "thumb-" + id(m) } class="thumb" href={ templ.URL(imageURL(m, "/large")) } hx-get={ mediaURL(m, "/preview") } hx-target="#preview" draggable="false">
			<img src={ imageURL(m, "/thumb") } alt={ t(ctx, "Preview of %s", m.Title) } loading="lazy" draggable="false"/>
		</a>
		<wa-tooltip for={ "thumb-" + id(m) }>
			if m.Kind == "stream" {
				{ streamSource(m) }
			} else {
				if m.Width > 0 {
					{ itoa(m.Width) }×{ itoa(m.Height) } ·
				}
				<wa-format-bytes value={ itoa(m.SizeBytes) }></wa-format-bytes>
			}
		</wa-tooltip>
		<div class="title">
			if edit == "title" {
				<form hx-post={ mediaURL(m, "/rename") } hx-trigger="submit, change" hx-target={ "#media-" + id(m) } hx-swap="outerHTML">
					@cancelOnEscape(m) {
						<wa-input name="title" value={ m.Title } size="s" aria-label={ t(ctx, "Title") } autofocus></wa-input>
					}
				</form>
			} else {
				<span class="editable" hx-get={ mediaURL(m, "/edit/title") } hx-target={ "#media-" + id(m) } hx-swap="outerHTML" title={ t(ctx, "Click to rename") }>{ m.Title }</span>
			}
			if !kiosk.Enabled(m) {
				<span class="off-note wa-caption-xs"><wa-icon name="eye-slash"></wa-icon> { t(ctx, "Disabled: skipped in playback") }</span>
			}
			if current {
				<div id="row-progress"></div>
			}
		</div>
		<span class="dur num">
			if m.Kind == "video" {
				<wa-icon name="film" label={ t(ctx, "Video") }></wa-icon> { Dur(m.DurationS) }
			} else if m.Kind == "stream" {
				<wa-icon name="tower-broadcast" label={ t(ctx, "Stream") }></wa-icon>
				if m.DurationS > 0 {
					{ Dur(m.DurationS) }
				} else {
					{ t(ctx, "Live") }
				}
			} else if edit == "duration" {
				<form hx-post={ mediaURL(m, "/duration") } hx-trigger="submit, change" hx-target={ "#media-" + id(m) } hx-swap="outerHTML">
					@cancelOnEscape(m) {
						<wa-number-input name="seconds" value={ itoa(m.ImageDurationS) } min="1" max="3600" size="s" without-steppers aria-label={ t(ctx, "Display time in seconds") } autofocus>
							<span slot="end">s</span>
						</wa-number-input>
					}
				</form>
			} else {
				<span class="editable" hx-get={ mediaURL(m, "/edit/duration") } hx-target={ "#media-" + id(m) } hx-swap="outerHTML" title={ t(ctx, "Click to change the display time") }>
					<wa-icon name="image" label={ t(ctx, "Image") }></wa-icon> { itoa(m.ImageDurationS) } s
				</span>
			}
		</span>
		<wa-dropdown class="menu" placement="bottom-end">
			<wa-button slot="trigger" size="s" appearance="plain"><wa-icon name="ellipsis" label={ t(ctx, "Actions") }></wa-icon></wa-button>
			if kiosk.Enabled(m) {
				<wa-dropdown-item class="disturbs" hx-post={ mediaURL(m, "/play") } hx-swap="none"><wa-icon slot="icon" name="play"></wa-icon> { t(ctx, "Show now") }</wa-dropdown-item>
			}
			if kiosk.Enabled(m) {
				<wa-dropdown-item class="disturbs-current" hx-post={ mediaURL(m, "/enabled") } hx-vals='{"on": "false"}' hx-target={ "#media-" + id(m) } hx-swap="outerHTML"><wa-icon slot="icon" name="eye-slash"></wa-icon> { t(ctx, "Disable") }</wa-dropdown-item>
			} else {
				<wa-dropdown-item hx-post={ mediaURL(m, "/enabled") } hx-vals='{"on": "true"}' hx-target={ "#media-" + id(m) } hx-swap="outerHTML"><wa-icon slot="icon" name="eye"></wa-icon> { t(ctx, "Enable") }</wa-dropdown-item>
			}
			<wa-dropdown-item hx-post={ mediaURL(m, "/move") } hx-vals='{"position": 1}' hx-target="#playlist" hx-swap="outerMorph"><wa-icon slot="icon" name="angles-up"></wa-icon> { t(ctx, "Move to top") }</wa-dropdown-item>
			<wa-dropdown-item hx-post={ mediaURL(m, "/move") } hx-vals='{"position": 1000000}' hx-target="#playlist" hx-swap="outerMorph"><wa-icon slot="icon" name="angles-down"></wa-icon> { t(ctx, "Move to bottom") }</wa-dropdown-item>
			<wa-dropdown-item hx-get={ mediaURL(m, "/edit/title") } hx-target={ "#media-" + id(m) } hx-swap="outerHTML"><wa-icon slot="icon" name="pen"></wa-icon> { t(ctx, "Rename") }</wa-dropdown-item>
			if m.Kind == "image" {
				<wa-dropdown-item hx-get={ mediaURL(m, "/edit/duration") } hx-target={ "#media-" + id(m) } hx-swap="outerHTML"><wa-icon slot="icon" name="clock"></wa-icon> { t(ctx, "Display time") }</wa-dropdown-item>
			}
			if m.Kind == "stream" && m.Format != "" {
				<wa-dropdown-item class="disturbs-current" hx-get={ mediaURL(m, "/format") } hx-target="#preview" hx-indicator="#playlist-busy"><wa-icon slot="icon" name="sliders"></wa-icon> { t(ctx, "Change format") }</wa-dropdown-item>
			}
			if downloadable(m) {
				<wa-dropdown-item hx-post={ mediaURL(m, "/download") } hx-swap="none"><wa-icon slot="icon" name="download"></wa-icon> { t(ctx, "Download instead") }</wa-dropdown-item>
			}
			<wa-divider></wa-divider>
			<wa-dropdown-item class="disturbs-current" variant="danger" hx-delete={ mediaURL(m, "") } hx-target="#playlist" hx-swap="outerMorph" hx-confirm={ t(ctx, "Delete “%s”?", m.Title) }>
				<wa-icon slot="icon" name="trash"></wa-icon> { t(ctx, "Delete") }
			</wa-dropdown-item>
		</wa-dropdown>
	</li>
}

// cancelOnEscape wraps an inline editor: Escape reloads the plain row.
templ cancelOnEscape(m db.Media) {
	<div hx-get={ mediaURL(m, "/row") } hx-trigger="keydown[key=='Escape']" hx-target={ "#media-" + id(m) } hx-swap="outerHTML">
		{ children... }
	</div>
}

// RowProgress is the thin live bar under the playing entry (pushed over SSE).
templ RowProgress(n NowPlaying) {
	<div id="row-progress">
		if n.Duration > 0 {
			<wa-progress-bar value={ percent(n.TimePos, n.Duration) } style={ barStyle(percent(n.TimePos, n.Duration), "") }></wa-progress-bar>
		}
	</div>
}

templ PreviewDialog(m db.Media) {
	<wa-dialog label={ m.Title } open light-dismiss class="preview">
		<img src={ imageURL(m, "/large") } alt={ m.Title }/>
		<div slot="footer" class="wa-cluster wa-gap-s wa-caption-s num">
			if m.Kind == "stream" {
				<span><wa-icon name="tower-broadcast"></wa-icon> { streamSource(m) }</span>
				<a href={ templ.URL(m.URL) } target="_blank" rel="noopener noreferrer">{ t(ctx, "Open link") }</a>
			} else if m.Kind == "video" {
				<span><wa-icon name="film"></wa-icon> { t(ctx, "Video") } · { Dur(m.DurationS) }</span>
			} else {
				<span><wa-icon name="image"></wa-icon> { t(ctx, "Image") } · { itoa(m.ImageDurationS) } s</span>
			}
			if m.Width > 0 {
				<span>{ itoa(m.Width) }×{ itoa(m.Height) }</span>
			}
			<wa-format-bytes value={ itoa(m.SizeBytes) }></wa-format-bytes>
			<span>{ t(ctx, "Position %d", m.Position) }</span>
		</div>
	</wa-dialog>
}
