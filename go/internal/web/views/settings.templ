package views

type Settings struct {
	HelpText      string
	Debug         bool
	BitrateK      int
	ImageDuration int
	HDMI          bool
}

// SettingsPage: one column, most used first. Each section saves on its own
// (field "section"), so the Wi-Fi card can sit between them without nesting forms.
templ SettingsPage(p Page, s Settings) {
	@Layout(p) {
		@PageHead("Settings")
		<div class="wa-stack wa-gap-m form-column">
			<wa-card>
				<div slot="header" class="wa-heading-s">{ t(ctx, "Web UI login") }</div>
				@PasswordForm()
			</wa-card>
			<wa-card>
				<div slot="header" class="wa-heading-s">{ t(ctx, "Processing") }</div>
				<form
					class="wa-stack wa-gap-m"
					hx-post="/settings"
					hx-swap="none"
				>
					<input
						type="hidden"
						name="section"
						value="processing"
					/>
					<wa-number-input
						class="field-s"
						name="video_bitrate_k"
						label={ t(ctx, "Video bitrate") }
						hint={ t(ctx, "For new uploads") }
						min="200"
						max="20000"
						step="100"
						size="s"
						without-steppers
						value={ itoa(s.BitrateK) }
					>
						<span slot="end">kbit/s</span>
					</wa-number-input>
					<wa-number-input
						class="field-s"
						name="image_duration_default"
						label={ t(ctx, "Display duration for images") }
						hint={ t(ctx, "When none is given") }
						min="1"
						max="3600"
						size="s"
						value={ itoa(s.ImageDuration) }
					>
						<span slot="end">s</span>
					</wa-number-input>
					<div>
						<wa-button
							type="submit"
							variant="brand"
							size="s"
						>
							{ t(ctx, "Save") }
						</wa-button>
					</div>
				</form>
			</wa-card>
			<wa-card>
				<div slot="header" class="wa-heading-s">{ t(ctx, "Debug and output") }</div>
				<form
					class="wa-stack wa-gap-s"
					hx-post="/settings"
					hx-trigger="change"
					hx-swap="none"
				>
					<input
						type="hidden"
						name="section"
						value="display"
					/>
					<wa-switch
						name="debug"
						value="true"
						size="s"
						checked?={ s.Debug }
						hint={ t(ctx, "Extra messages in the Telegram chat") }
					>
						{ t(ctx, "Debug mode") }
					</wa-switch>
					<span class="wa-caption-xs">
						{ t(ctx, "Output:") }
						if s.HDMI {
							{ t(ctx, "HDMI") }
						} else {
							{ t(ctx, "Composite (PAL)") }
						}
						· @templ.Raw(t(ctx, "set by %s", "<code>~/.needs-hdmi</code>"))
					</span>
				</form>
			</wa-card>
			@WifiCard()
			@HelpForm(s.HelpText)
		</div>
	}
}

// HelpForm is re-rendered after saving: an empty text brings back the default.
templ HelpForm(help string) {
	<wa-card id="help-card">
		<div slot="header" class="wa-heading-s">{ t(ctx, "Help text") }</div>
		<form
			class="wa-stack wa-gap-s"
			hx-post="/settings"
			hx-target="#help-card"
			hx-swap="outerHTML"
		>
			<input
				type="hidden"
				name="section"
				value="help"
			/>
			<wa-textarea
				name="help_text"
				aria-label={ t(ctx, "Help text") }
				hint={ t(ctx, "Telegram /help and welcome message for new members. Empty restores the default.") }
				rows="8"
				resize="auto"
				size="s"
				value={ help }
			></wa-textarea>
			<div>
				<wa-button
					type="submit"
					variant="brand"
					size="s"
				>
					{ t(ctx, "Save") }
				</wa-button>
			</div>
		</form>
	</wa-card>
}

templ PasswordForm() {
	<form
		class="wa-stack wa-gap-m"
		hx-post="/settings/password"
		hx-swap="none"
	>
		<wa-input
			class="field-m"
			type="password"
			name="password"
			label={ t(ctx, "New password for the web UI") }
			hint={ t(ctx, "At least 8 characters. Logs out every session.") }
			password-toggle
			required
			minlength="8"
			autocomplete="new-password"
			size="s"
		></wa-input>
		<div>
			<wa-button type="submit" size="s"><wa-icon slot="start" name="key"></wa-icon> { t(ctx, "Change") }</wa-button>
		</div>
	</form>
}
