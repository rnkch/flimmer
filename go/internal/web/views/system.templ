package views

import (
	"fmt"
	"github.com/rnkch/flimmerkiste/internal/core"
	"github.com/rnkch/flimmerkiste/internal/store/db"
	"github.com/rnkch/flimmerkiste/internal/sysinfo"
)

templ SystemPage(p Page, si sysinfo.Info, mediaBytes int64, events []db.Event, accessURL, fingerprint string) {
	@Layout(p) {
		@PageHead("System") {
			<wa-button
				class="disturbs"
				size="s"
				hx-post="/player/restart"
				hx-swap="none"
				hx-confirm={ t(ctx, "Restart the player? Playback starts over from the first entry. For a frozen picture or a player that doesn't react.") }
			>
				<wa-icon slot="start" name="rotate"></wa-icon> { t(ctx, "Restart player") }
			</wa-button>
			<wa-button
				class="disturbs"
				size="s"
				hx-post="/system/restart"
				hx-swap="none"
				hx-confirm={ t(ctx, "Restart the whole service? The screen goes dark for a few seconds and playback starts over; a running conversion or download starts over too.") }
			>
				<wa-icon slot="start" name="power-off"></wa-icon> { t(ctx, "Restart service") }
			</wa-button>
		}
		@SystemStats(si, mediaBytes)
		@AccessCard(accessURL, fingerprint)
		@UpgradeCardLoading()
		@YtDlpCardLoading()
		<wa-card class="panel">
			<div slot="header" class="wa-heading-s">{ t(ctx, "Log") }</div>
			@EventLog(events)
		</wa-card>
	}
}

templ statCard(icon, label string) {
	<wa-card>
		<div class="wa-flank wa-gap-s">
			<wa-icon
				name={ icon }
				style="font-size: var(--wa-font-size-xl); color: var(--wa-color-brand-on-quiet);"
			></wa-icon>
			<div class="wa-stack wa-gap-3xs stat">
				<span class="wa-caption-xs">{ t(ctx, label) }</span>
				{ children... }
			</div>
		</div>
	</wa-card>
}

templ SystemStats(si sysinfo.Info, mediaBytes int64) {
	<div
		id="stats"
		class="wa-grid wa-gap-s"
		style="--min-column-size: 13rem;"
		hx-get="/system/stats"
		hx-trigger="every 10s, job from:body"
		hx-swap="outerMorph"
	>
		@statCard("hard-drive", "Free storage") {
			if si.DiskTotal > 0 {
				<span class="wa-heading-m"><wa-format-bytes value={ itoa(int64(si.DiskFree)) }></wa-format-bytes></span>
				<wa-progress-bar
					value={ itoa(int64(100 - si.DiskFree*100/si.DiskTotal)) }
					style={ barStyle(itoa(int64(100-si.DiskFree*100/si.DiskTotal)), " --track-height: 4px;") }
				></wa-progress-bar>
				<span class="wa-caption-xs">{ t(ctx, "of") } <wa-format-bytes value={ itoa(int64(si.DiskTotal)) }></wa-format-bytes> · { t(ctx, "media") } <wa-format-bytes value={ itoa(mediaBytes) }></wa-format-bytes></span>
			} else {
				<span class="wa-heading-m">–</span>
			}
		}
		@statCard("temperature-half", "CPU") {
			if si.TempC > 0 {
				<span class="wa-heading-m">{ fmt.Sprintf("%.0f °C", si.TempC) }</span>
			} else {
				<span class="wa-heading-m">–</span>
			}
			<span class="wa-caption-xs">
				{ t(ctx, "Load %.2f", si.Load1) }
				if si.HasThrottle() && len(si.ThrottleNow()) == 0 {
					· { t(ctx, "not throttled") }
				}
			</span>
			@throttleState(si)
		}
		@statCard("memory", "Free memory") {
			if si.MemTotal > 0 {
				<span class="wa-heading-m"><wa-format-bytes value={ itoa(int64(si.MemAvail)) }></wa-format-bytes></span>
				<span class="wa-caption-xs">{ t(ctx, "of") } <wa-format-bytes value={ itoa(int64(si.MemTotal)) }></wa-format-bytes></span>
			} else {
				<span class="wa-heading-m">–</span>
			}
		}
		@statCard("clock", "Up for") {
			if si.Uptime > 0 {
				<span class="wa-heading-m">{ uptime(ctx, si.Uptime) }</span>
			} else {
				<span class="wa-heading-m">–</span>
			}
		}
	</div>
}

// throttleState says only what someone can act on: a weak power supply (now
// or since boot) and running slower right now. Having been warm earlier is
// normal under load and not shown (the Telegram /status has it).
//
// The tags sit at the top right of the card, next to its label, so the card never changes height
// (and the grid doesn't jump) when one appears; they are short, the full text is the tooltip.
templ throttleState(si sysinfo.Info) {
	if si.UnderVoltageNow() || si.UnderVoltageEarlier() || si.SlowedNow() {
		<span class="stat-badges">
			switch  {
				case si.UnderVoltageNow():
					<wa-tag
						id="tag-power"
						size="xs"
						variant="danger"
					>
						{ t(ctx, "Weak power") }
					</wa-tag>
					<wa-tooltip for="tag-power">{ t(ctx, "Power supply too weak – check the power adapter") }</wa-tooltip>
				case si.UnderVoltageEarlier():
					<wa-tag
						id="tag-power"
						size="xs"
						variant="danger"
						appearance="outlined"
					>
						{ t(ctx, "Weak power") }
					</wa-tag>
					<wa-tooltip for="tag-power">{ t(ctx, "Power supply was too weak – check the power adapter") }</wa-tooltip>
			}
			if si.SlowedNow() {
				<wa-tag
					id="tag-slow"
					size="xs"
					variant="warning"
				>
					{ t(ctx, "Slowed") }
				</wa-tag>
				<wa-tooltip for="tag-slow">{ t(ctx, "Running a bit slower right now (warm)") }</wa-tooltip>
			}
		</span>
	}
}

templ EventLog(events []db.Event) {
	<div
		id="log"
		class="rows log"
		hx-get="/system/log"
		hx-trigger="log from:body"
		hx-swap="outerMorph"
	>
		if len(events) == 0 {
			<div class="empty">{ t(ctx, "No entries.") }</div>
		}
		for _, e := range events {
			<div>
				<span class="at">{ shortTime(ctx, e.At) }</span>
				<span class={ e.Level }>{ e.Level }</span>
				<span>{ e.Message }</span>
			</div>
		}
	</div>
}

// UpgradeCardLoading is replaced by UpgradeCard: asking GitHub takes a moment.
templ UpgradeCardLoading() {
	<wa-card
		id="upgrade"
		hx-get="/system/upgrade"
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<div class="wa-stack wa-gap-3xs">
			<span class="wa-caption-xs">Flimmerkiste</span>
			<wa-spinner></wa-spinner>
		</div>
	</wa-card>
}

// UpgradeCard shows the running version and, when GitHub has a newer release,
// the button to install it (the install blocks until it is downloaded and
// checked, the spinner shows that). msg is why the check failed, if it did.
templ UpgradeCard(info core.UpgradeInfo, msg string) {
	<wa-card id="upgrade">
		<div class="wa-split wa-align-items-center">
			<div class="wa-stack wa-gap-3xs">
				<span class="wa-caption-xs">Flimmerkiste</span>
				<span class="num">{ info.Current }</span>
				switch  {
					case msg != "":
						<span class="wa-caption-xs">{ msg }</span>
					case info.Newer:
						<span class="wa-caption-xs">
							<a
								href={ templ.URL(info.URL) }
								target="_blank"
								rel="noopener"
							>
								{ t(ctx, "%s is available", info.Latest) }
							</a>
						</span>
					default:
						<span class="wa-caption-xs"><wa-icon name="circle-check"></wa-icon> { t(ctx, "Up to date") }</span>
				}
				if msg == "" && !info.Release {
					<span class="wa-caption-xs">{ t(ctx, "Development build, not a release") }</span>
				}
			</div>
			<div class="wa-cluster wa-gap-xs">
				<wa-spinner id="upgrade-busy" class="htmx-indicator"></wa-spinner>
				<wa-button
					size="s"
					appearance="plain"
					hx-get="/system/upgrade?check=1"
					hx-target="#upgrade"
					hx-swap="outerHTML"
					hx-indicator="#upgrade-busy"
				>
					<wa-icon slot="start" name="rotate"></wa-icon> { t(ctx, "Check again") }
				</wa-button>
				if msg == "" && info.Newer && info.CanInstall {
					<wa-button
						class="disturbs"
						size="s"
						variant="brand"
						hx-post="/system/upgrade"
						hx-swap="none"
						hx-indicator="#upgrade-busy"
						hx-confirm={ t(ctx, "Install %s now? Flimmerkiste restarts: the screen goes dark for a few seconds and playback starts over; a running conversion or download starts over too.", info.Latest) }
					>
						<wa-icon slot="start" name="download"></wa-icon> { t(ctx, "Install %s", info.Latest) }
					</wa-button>
				}
			</div>
		</div>
	</wa-card>
}

// YtDlpCardLoading is replaced by YtDlpCard once loaded: asking the standalone
// yt-dlp for its version takes about 5 s on a Pi 3B+ (it unpacks itself on
// every start), so the page doesn't wait for it.
templ YtDlpCardLoading() {
	<wa-card
		id="ytdlp"
		hx-get="/system/ytdlp"
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<div class="wa-stack wa-gap-3xs">
			<span class="wa-caption-xs">{ t(ctx, "Downloader (yt-dlp)") }</span>
			<wa-spinner></wa-spinner>
		</div>
	</wa-card>
}

templ YtDlpCard(version string) {
	<wa-card id="ytdlp">
		<div class="wa-split wa-align-items-center">
			<div class="wa-stack wa-gap-3xs">
				<span class="wa-caption-xs">{ t(ctx, "Downloader (yt-dlp)") }</span>
				if version != "" {
					<span class="num">{ version }</span>
				} else {
					<span>{ t(ctx, "not installed") }</span>
				}
			</div>
			if version != "" {
				<div class="wa-cluster wa-gap-xs">
					<wa-spinner id="ytdlp-updating" class="htmx-indicator"></wa-spinner>
					<wa-button
						size="s"
						hx-post="/system/ytdlp-update"
						hx-target="#ytdlp"
						hx-swap="outerHTML"
						hx-indicator="#ytdlp-updating"
					>
						<wa-icon slot="start" name="rotate"></wa-icon> { t(ctx, "Update") }
					</wa-button>
				</div>
			}
		</div>
	</wa-card>
}

// AccessCard: how phones on the local network reach this page.
templ AccessCard(url, fingerprint string) {
	<wa-card>
		<div class="access">
			if url != "" {
				<img
					src="/qr.png"
					alt={ t(ctx, "QR code for %s", url) }
					width="132"
					height="132"
				/>
			}
			<div class="wa-stack wa-gap-xs">
				<span class="wa-caption-xs">{ t(ctx, "Web interface on the local network") }</span>
				if url != "" {
					<a href={ templ.URL(url) } class="num">{ url }</a>
				} else {
					<span>{ t(ctx, "No address on the local network found") }</span>
				}
				if fingerprint != "" {
					<span class="wa-caption-xs">{ t(ctx, "Self-signed certificate; browsers warn once. SHA-256 fingerprint:") }</span>
					<code class="fingerprint">{ fingerprint }</code>
				}
				if url != "" {
					<div>
						<wa-button
							class="disturbs"
							size="s"
							hx-post="/player/qr"
							hx-swap="none"
						>
							<wa-icon slot="start" name="qrcode"></wa-icon> { t(ctx, "Show on screen") }
						</wa-button>
					</div>
				}
			</div>
		</div>
	</wa-card>
}
