package views

import (
	"context"
	"fmt"

	"github.com/rnkch/flimmerkiste/internal/kiosk"
	"github.com/rnkch/flimmerkiste/internal/store/db"
)

// URLPreview fills the add form after "Check": the preview with the format
// choice goes to #url-result, the buttons to #url-actions. Both are inside
// the add form, so name, position and duration are posted with them.
templ URLPreview(info kiosk.URLInfo) {
	<hx-partial hx-target="#url-result" hx-swap="innerHTML">
		<div class="url-preview" data-title={ info.Title } x-init="linkChecked($el.dataset.title)">
			<input type="hidden" name="checked_url" value={ info.URL }/>
			<input type="hidden" name="page_title" value={ info.Title }/>
			<input type="hidden" name="thumbnail" value={ info.Thumbnail }/>
			<input type="hidden" name="duration" value={ fmt.Sprint(info.Duration) }/>
			if info.Thumbnail != "" {
				<img src={ info.Thumbnail } alt="" referrerpolicy="no-referrer"/>
			} else {
				<div class="no-thumb"><wa-icon name="tower-broadcast"></wa-icon></div>
			}
			<div class="wa-stack wa-gap-xs">
				<div>
					<strong>{ info.Title }</strong>
					<div class="wa-caption-xs num">
						{ info.Site }
						if info.Live {
							· { t(ctx, "Live") }
						} else if info.Duration > 0 {
							· { Dur(info.Duration) }
						}
					</div>
				</div>
				if info.PlaylistCount > 0 {
					<wa-callout variant="neutral" size="s">
						<wa-icon slot="icon" name="list"></wa-icon>
						{ t(ctx, "This link is a playlist with %d videos. Only its first video is added; paste a video's own link for another one.", info.PlaylistCount) }
					</wa-callout>
				}
				if info.Unprobed != "" {
					<wa-callout variant="warning" size="s">
						<wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
						{ t(ctx, "No format information found. You can still try to play it directly, but the Pi might be overloaded.") }
						<div class="wa-caption-xs">{ info.Unprobed }</div>
						<div class="wa-caption-xs"><a href="/system" { pageLink("/system")... }>{ t(ctx, "An outdated yt-dlp is a common cause: update it on the System page.") }</a></div>
					</wa-callout>
				} else if len(info.Formats) > 1 || (len(info.Formats) == 1 && info.Formats[0].Height > 0) {
					@formatSelect(info, info.Auto)
				} else if len(info.Formats) == 1 {
					<input type="hidden" name="format" value={ formatValue(info, info.Auto) }/>
				}
			</div>
		</div>
	</hx-partial>
	<hx-partial hx-target="#url-actions" hx-swap="innerHTML">
		<wa-button size="s" variant="brand" hx-post="/url/add" hx-vals='{"mode": "stream"}' hx-swap="none">
			<wa-icon slot="start" name="play"></wa-icon> { t(ctx, "Play directly") }
		</wa-button>
		if !info.Live {
			<wa-button size="s" hx-post="/url/add" hx-vals='{"mode": "download"}' hx-swap="none">
				<wa-icon slot="start" name="download"></wa-icon> { t(ctx, "Download") }
			</wa-button>
		}
		<span class="wa-caption-xs">
			if info.Unprobed != "" {
				{ t(ctx, "Without format information it plays with a safe limit (720 lines, 30 fps).") }
			} else if info.Live {
				{ t(ctx, "Live streams play directly and never end on their own.") }
			} else {
				{ t(ctx, "Directly: no disk space, needs internet. Download: plays offline.") }
			}
		</span>
	</hx-partial>
}

templ formatSelect(info kiosk.URLInfo, selected string) {
	<wa-select name="format" size="s" label={ t(ctx, "Format") } value={ formatValue(info, selected) }>
		for _, f := range info.Formats {
			<wa-option value={ formatValue(info, f.Spec) }>
				{ formatLabel(ctx, f) }
				if f.Auto(info) {
					<wa-tag slot="end" size="xs" variant="brand">{ t(ctx, "best for the CRT") }</wa-tag>
				} else if f.Heavy() {
					<span slot="end" class="wa-caption-xs">{ t(ctx, "may be too much for the Pi") }</span>
				} else if f.Slow {
					<span slot="end" class="wa-caption-xs">{ t(ctx, "no hardware decoding on the Pi") }</span>
				}
			</wa-option>
		}
	</wa-select>
}

// FormatDialog changes the format of a stream entry.
templ FormatDialog(m db.Media, info kiosk.URLInfo, current string) {
	<wa-dialog label={ t(ctx, "Change format") } open light-dismiss>
		<form id="format-form" class="wa-stack wa-gap-s" hx-post={ mediaURL(m, "/format") } hx-target="#preview" hx-swap="innerHTML">
			<span class="wa-caption-s">{ m.Title }</span>
			@formatSelect(info, current)
		</form>
		<wa-button slot="footer" type="submit" form="format-form" variant="brand" size="s">{ t(ctx, "Save") }</wa-button>
	</wa-dialog>
}

// formatValue carries size and height along with the spec: the disk check
// needs the size, a stream's fallback rule the height.
func formatValue(info kiosk.URLInfo, spec string) string {
	if f, ok := info.Format(spec); ok {
		return fmt.Sprintf("%s %d %d", f.Spec, f.Size, f.Height)
	}
	return spec + " 0 0"
}

func formatLabel(ctx context.Context, f kiosk.URLFormat) string {
	if f.Height == 0 {
		return t(ctx, "Best available")
	}
	s := fmt.Sprintf("%dp", f.Height)
	if f.FPS > 30 {
		s += fmt.Sprint(f.FPS)
	}
	s += " · " + f.Codec
	if f.Size > 0 {
		s += fmt.Sprintf(" · ~%d MB", f.Size>>20)
	}
	return s
}
